# Default is local persistent JSON storage; no account or secret required.
ECOSORT_STORAGE=local
ECOSORT_DATA_FILE=data/ecosort.json
ECOSORT_MAX_UPLOAD_BYTES=4194304
# The trained model threshold is 0.75. Leave unset to use model metadata.
# ECOSORT_AI_THRESHOLD=0.75

# Optional Adafruit IO cloud persistence. Create these feeds in Adafruit IO first.
# Never commit a real AIO_KEY or paste it into chat.
# ECOSORT_STORAGE=adafruit_io
# AIO_USERNAME=your_username
# AIO_KEY=your_active_key
# AIO_BASE_URL=https://io.adafruit.com/api/v2
# AIO_TIMEOUT_SECONDS=8

# Grouped feeds use keys such as ecosort.game-score
AIO_FEED_PREFIX=
